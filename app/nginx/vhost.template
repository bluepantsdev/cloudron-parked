# ──────────────────────────────────────────────────────────────────────────────
# vhost.template — Per-domain nginx server block template
#
# Tokens replaced by generate-vhosts.sh at container startup:
#   __DOMAIN__   →  the exact domain name (e.g. parked-example.com)
#
# Each domain gets its own:
#   • server_name directive   (matches incoming Host header)
#   • root directory          (/tmp/parking/www/<domain>/)
#   • pre-generated index.html  (rendered from www/template.html)
#
# Image resolution order (handled by the /img/ location):
#   1. /app/data/images/<domain>.(png|jpg|svg)  – per-domain custom image
#   2. /app/pkg/www/default/img/default.svg     – bundled fallback
#
# ── DO NOT EDIT THIS FILE AT RUNTIME — it is read-only in /app/pkg/ ──────────
# To change per-domain content, edit /app/data/domains.json and restart the app.
# ──────────────────────────────────────────────────────────────────────────────

server {
    listen      8000;
    server_name __DOMAIN__;

    # Root is an ephemeral directory under /tmp/ generated at startup.
    # It contains only the rendered index.html for this domain.
    root  /tmp/parking/www/__DOMAIN__;
    index index.html;

    # ── Main page ─────────────────────────────────────────────────────────────
    location = / {
        try_files /index.html =404;
    }

    # ── VHost configuration viewer ────────────────────────────────────────────
    location = /vhosts {
        alias /app/pkg/www/vhosts.html;
        default_type "text/html; charset=utf-8";
    }

    # ── VHost configuration JSON ──────────────────────────────────────────────
    location = /vhosts.json {
        alias /app/data/domains.json;
        default_type "application/json; charset=utf-8";
    }

    # ── Redirect all other paths to root ──────────────────────────────────────
    location / {
        return 301 $scheme://$host/;
    }

    # ── Domain images ─────────────────────────────────────────────────────────
    # Serve images from persistent storage (/app/data/images/).
    # The default SVG is copied there at startup, so it's always available.
    location /img/ {
        alias /app/data/images/;

        # Cache images aggressively — they rarely change
        expires    30d;
        add_header Cache-Control "public, immutable";
    }

    # ── Favicon ───────────────────────────────────────────────────────────────
    location = /favicon.ico {
        alias /app/pkg/www/default/img/default.svg;
        expires 7d;
        log_not_found off;
    }

    # ── Security headers ──────────────────────────────────────────────────────
    add_header X-Frame-Options        "SAMEORIGIN"  always;
    add_header X-Content-Type-Options "nosniff"     always;
    add_header Referrer-Policy        "no-referrer" always;
}
